<Window x:Class="NetFreeWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="מעקב חבילת גלישה" Width="290" Height="150"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize"
        FlowDirection="RightToLeft" SizeToContent="Height">
        
    <Border x:Name="MainBorder" CornerRadius="12" Background="#DD1A1A1A" BorderBrush="#33FFFFFF" BorderThickness="1" 
            Padding="15,12" MouseLeftButtonDown="Window_MouseDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" Opacity="0.4" ShadowDepth="3" />
        </Border.Effect>
        <Border.Resources>
            <Style x:Key="IconButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FontFamily" Value="Segoe UI Symbol"/>
                <Setter Property="Foreground" Value="{Binding Foreground, ElementName=TitleText}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}">
                                <TextBlock Text="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" 
                                           Foreground="{TemplateBinding Foreground}" FontFamily="{TemplateBinding FontFamily}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Opacity" Value="0.7"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Border.Resources>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                <TextBlock x:Name="TitleText" Text="גלישה - נטפרי" FontWeight="SemiBold" FontSize="14" Foreground="White" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button Style="{StaticResource IconButtonStyle}" Content="↻" Width="24" Height="24" FontSize="14" Click="RefreshBtn_Click" ToolTip="רענן נתונים" x:Name="BtnRefresh" />
                    <Button Style="{StaticResource IconButtonStyle}" Content="⚙" Width="24" Height="24" FontSize="14" Margin="3,0" Click="SettingsBtn_Click" ToolTip="הגדרות" x:Name="BtnSettings" />
                    <Button Style="{StaticResource IconButtonStyle}" Content="✕" Width="24" Height="24" FontSize="12" Click="CloseBtn_Click" ToolTip="סגור" x:Name="BtnClose" />
                </StackPanel>
            </DockPanel>

            <!-- Stats -->
            <Grid Grid.Row="1" Margin="0,0,0,10" x:Name="StatsGrid" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="נוצל עד כה:" Grid.Row="0" Grid.Column="0" Foreground="#888888" FontSize="14" Margin="0,2"/>
                <TextBlock x:Name="TxtUsed" Text="GB 0.0" Grid.Row="0" Grid.Column="1" FontWeight="Bold" Foreground="{Binding Foreground, ElementName=TitleText}" FontSize="14" Margin="0,2"/>

                <TextBlock Text="סה&quot;כ בחבילה:" Grid.Row="1" Grid.Column="0" Foreground="#888888" FontSize="14" Margin="0,2"/>
                <TextBlock x:Name="TxtTotal" Text="GB 0.0" Grid.Row="1" Grid.Column="1" FontWeight="Bold" Foreground="{Binding Foreground, ElementName=TitleText}" FontSize="14" Margin="0,2"/>

                <TextBlock Text="תקין להיום:" Grid.Row="2" Grid.Column="0" Foreground="#888888" FontSize="14" Margin="0,2"/>
                <TextBlock x:Name="TxtExpected" Text="GB 0.0" Grid.Row="2" Grid.Column="1" FontWeight="Bold" Foreground="{Binding Foreground, ElementName=TitleText}" FontSize="14" Margin="0,2"/>
            </Grid>
            <TextBlock x:Name="UsageText" Grid.Row="1" Text="טוען נתונים..." FontSize="14" Foreground="#888888" Margin="0,0,0,8"/>

            <!-- Progress -->
            <Grid Grid.Row="2" Margin="0,0,0,10" FlowDirection="LeftToRight">
                <Border x:Name="ProgressBg" Background="#33FFFFFF" Height="8" CornerRadius="4" />
                <Border x:Name="ProgressBar" Background="#60CDFF" Height="8" CornerRadius="4" HorizontalAlignment="Right" Width="0"/>
                <Border x:Name="ExpectedMarker" Background="{Binding Foreground, ElementName=TitleText}" Opacity="0.5" Width="2" Height="14" CornerRadius="1" HorizontalAlignment="Right" Margin="0,-3,0,-3" Visibility="Collapsed" />
            </Grid>

            <!-- Status Box -->
            <Border x:Name="StatusBox" Grid.Row="3" Background="#20FFB74D" CornerRadius="8" Padding="10">
                <TextBlock x:Name="StatusText1" Text="מקבל מידע מהשרת..." Foreground="#FFB74D" TextWrapping="Wrap" FontSize="13" />
            </Border>

            <!-- Settings View (Overlay) -->
            <Border x:Name="SettingsView" Grid.Row="1" Grid.RowSpan="3" Background="#EE1A1A1A" Visibility="Collapsed" CornerRadius="8" Padding="5">
                <StackPanel>
                    <TextBlock Text="תאריך התחלה" Foreground="{Binding Foreground, ElementName=UsageText}" FontSize="11" Margin="0,0,0,3"/>
                    <TextBox x:Name="StartDateInput" Height="24" Padding="3" Margin="0,0,0,8" 
                             Background="#33FFFFFF" Foreground="White" BorderThickness="0" ToolTip="פורמט: DD/MM/YYYY"/>

                    <TextBlock Text="חבילה (GB)" Foreground="{Binding Foreground, ElementName=UsageText}" FontSize="11" Margin="0,0,0,3"/>
                    <TextBox x:Name="QuotaInput" Height="24" Padding="3" Margin="0,0,0,8" 
                             Background="#33FFFFFF" Foreground="White" BorderThickness="0"/>

                    <CheckBox x:Name="WeekendCheckbox" Margin="0,0,0,12" VerticalContentAlignment="Center">
                        <TextBlock Text="סופ&quot;ש כיום אחד" Foreground="{Binding Foreground, ElementName=UsageText}" FontSize="11" />
                    </CheckBox>

                    <Button Content="שמור וחזור" Background="#2196F3" Foreground="White" BorderThickness="0" Height="28" 
                            Cursor="Hand" Click="SaveBtn_Click" FontSize="12">
                        <Button.Resources>
                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>