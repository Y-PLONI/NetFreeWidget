<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 com rescap">

  <Identity
    Name="NetFreeWidget"
    Publisher="CN=YourPublisher"
    Version="1.0.0.0" />

  <Properties>
    <DisplayName>גלישה - נטפרי</DisplayName>
    <PublisherDisplayName>Your Name</PublisherDisplayName>
    <Logo>ProviderAssets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="he-IL"/>
    <Resource Language="en-US"/>
  </Resources>

  <Applications>
    <Application Id="App"
      Executable="NetFreeBoardWidgetProvider\NetFreeBoardWidgetProvider.exe"
      EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="גלישה - נטפרי"
        Description="מעקב חבילת גלישה נטפרי"
        BackgroundColor="transparent"
        Square150x150Logo="ProviderAssets\Square150x150Logo.png"
        Square44x44Logo="ProviderAssets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="ProviderAssets\Wide310x150Logo.png" />
      </uap:VisualElements>

      <Extensions>
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:ExeServer Executable="NetFreeBoardWidgetProvider\NetFreeBoardWidgetProvider.exe" DisplayName="NetFree Widget Provider">
              <com:Class Id="E7B3C2A1-4F5D-4A8B-9C3E-1D2F3A4B5C6D" DisplayName="NetFree Widget Provider" />
            </com:ExeServer>
          </com:ComServer>
        </com:Extension>

        <uap3:Extension Category="windows.appExtension">
          <uap3:AppExtension Name="com.microsoft.windows.widgets" DisplayName="גלישה - נטפרי" Id="NetFreeWidgetApp" PublicFolder="Public">
            <uap3:Properties>
              <WidgetProvider>
                <ProviderIcons>
                  <Icon Path="ProviderAssets\StoreLogo.png" />
                </ProviderIcons>
                <Activation>
                  <CreateInstance ClassId="E7B3C2A1-4F5D-4A8B-9C3E-1D2F3A4B5C6D" />
                </Activation>
                <Definitions>
                  <Definition Id="NetFree_Usage_Widget"
                    DisplayName="גלישה - נטפרי"
                    Description="מעקב חבילת גלישה נטפרי בזמן אמת"
                    AllowMultiple="false"
                    IsCustomizable="false">
                    <Capabilities>
                      <Capability>
                        <Size Name="small" />
                      </Capability>
                      <Capability>
                        <Size Name="medium" />
                      </Capability>
                      <Capability>
                        <Size Name="large" />
                      </Capability>
                    </Capabilities>
                    <ThemeResources>
                      <Icons>
                        <Icon Path="ProviderAssets\WidgetIcon.png" />
                      </Icons>
                      <Screenshots>
                        <Screenshot Path="ProviderAssets\WidgetPreview.png" DisplayAltText="תצוגה מקדימה של ווידג'ט נטפרי" />
                      </Screenshots>
                    </ThemeResources>
                  </Definition>
                </Definitions>
              </WidgetProvider>
            </uap3:Properties>
          </uap3:AppExtension>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <Capability Name="internetClient" />
  </Capabilities>
</Package>
